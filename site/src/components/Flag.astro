---
/**
 * SVG 国旗组件：Windows 的 Chrome/Edge 不渲染国旗 emoji（显示为字母），
 * 故四国国旗一律自绘，跨平台显示一致。
 */
interface Props {
  lang: string;
  class?: string;
}
const { lang, class: cls = 'h-[1.25em] w-auto' } = Astro.props;
const c = `inline-block align-middle rounded-[2px] shadow-sm ${cls}`;
---
{lang === 'ja' && (
  <svg class={c} viewBox="0 0 24 16" role="img" aria-label="日本国旗">
    <rect width="24" height="16" fill="#fff" />
    <circle cx="12" cy="8" r="4.8" fill="#bc0028" />
  </svg>
)}
{lang === 'ko' && (
  <svg class={c} viewBox="0 0 24 16" role="img" aria-label="韩国国旗">
    <rect width="24" height="16" fill="#fff" />
    <circle cx="12" cy="8" r="4" fill="#0047a0" />
    <path d="M8 8a4 4 0 0 1 8 0a2 2 0 0 1-4 0a2 2 0 0 0-4 0z" fill="#cd2e3a" />
    {/* 四卦：乾（左上，三连）坤（右下，六断）坎（右上，中满）离（左下，中缺）
        局部坐标：三条横线长 7.4、粗 1.2、间距 0.55；断线中缝 0.55 */}
    <g fill="#000">
      <g transform="translate(7.05 3.05) rotate(135)">
        <rect x="-3.7" y="-2.35" width="7.4" height="1.2" />
        <rect x="-3.7" y="-0.6" width="7.4" height="1.2" />
        <rect x="-3.7" y="1.15" width="7.4" height="1.2" />
      </g>
      <g transform="translate(16.95 3.05) rotate(225)">
        <rect x="-3.7" y="-2.35" width="3.43" height="1.2" /><rect x="0.28" y="-2.35" width="3.43" height="1.2" />
        <rect x="-3.7" y="-0.6" width="7.4" height="1.2" />
        <rect x="-3.7" y="1.15" width="3.43" height="1.2" /><rect x="0.28" y="1.15" width="3.43" height="1.2" />
      </g>
      <g transform="translate(16.95 12.95) rotate(45)">
        <rect x="-3.7" y="-2.35" width="3.43" height="1.2" /><rect x="0.28" y="-2.35" width="3.43" height="1.2" />
        <rect x="-3.7" y="-0.6" width="3.43" height="1.2" /><rect x="0.28" y="-0.6" width="3.43" height="1.2" />
        <rect x="-3.7" y="1.15" width="3.43" height="1.2" /><rect x="0.28" y="1.15" width="3.43" height="1.2" />
      </g>
      <g transform="translate(7.05 12.95) rotate(-45)">
        <rect x="-3.7" y="-2.35" width="7.4" height="1.2" />
        <rect x="-3.7" y="-0.6" width="3.43" height="1.2" /><rect x="0.28" y="-0.6" width="3.43" height="1.2" />
        <rect x="-3.7" y="1.15" width="7.4" height="1.2" />
      </g>
    </g>
  </svg>
)}
{lang === 'th' && (
  <svg class={c} viewBox="0 0 24 16" role="img" aria-label="泰国国旗">
    <rect width="24" height="16" fill="#a51931" />
    <rect y="2.667" width="24" height="10.667" fill="#f4f5f8" />
    <rect y="5.333" width="24" height="5.333" fill="#2d2a4a" />
  </svg>
)}
{lang === 'vi' && (
  <svg class={c} viewBox="0 0 24 16" role="img" aria-label="越南国旗">
    <rect width="24" height="16" fill="#da251d" />
    <path
      d="M12 3.2 L13.078 6.517 L16.565 6.517 L13.744 8.566 L14.822 11.883 L12 9.834 L9.178 11.883 L10.256 8.566 L7.435 6.517 L10.922 6.517 Z"
      fill="#ffff00"
    />
  </svg>
)}
