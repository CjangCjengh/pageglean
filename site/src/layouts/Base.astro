---
interface Props { title?: string }
const { title = '拾页 PageGlean · 从小说里学会一门语言' } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content="面向中文母语者的日/韩/泰/越学习站，知识点全部取自真实轻小说语境。" />
  </head>
  <body class="min-h-screen bg-ink text-slate-200 antialiased">
    <div class="aurora min-h-screen">
      <header class="glass sticky top-0 z-50">
        <nav class="mx-auto flex max-w-6xl items-center gap-6 px-6 py-3">
          <a href="/" class="flex items-center gap-2 text-lg font-bold tracking-wide">
            <img src="/favicon.svg" alt="" class="h-7 w-7" />
            <span class="bg-gradient-to-r from-rose-400 via-sky-400 to-emerald-400 bg-clip-text text-transparent">
              拾页
            </span>
            <span class="text-xs font-normal text-slate-500">PageGlean</span>
          </a>
          <div class="ml-auto flex items-center gap-5 text-sm text-slate-400">
            <a href="/browse/ja" class="transition hover:text-slate-100">语法库</a>
            <a href="/srs" class="transition hover:text-slate-100">记忆卡</a>
            <a href="/quiz" class="transition hover:text-slate-100">练习</a>
            <a href="/search" class="transition hover:text-slate-100">搜索</a>
          </div>
        </nav>
      </header>
      <main class="mx-auto max-w-6xl px-6 py-10">
        <slot />
      </main>
      <footer class="mx-auto max-w-6xl px-6 pb-10 text-xs text-slate-600">
        拾页 PageGlean · 例句摘自原作文，仅作教学示例 · 由 AI 管线提取、人工校审
      </footer>
    </div>
  </body>
</html>
