---
import { LANGS } from '../../lib/langs';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0; url=/browse/${lang}/all/1`} />
    <title>跳转中……</title>
    <script is:inline define:vars={{ lang }}>
      location.replace(`/browse/${lang}/all/1`);
    </script>
  </head>
  <body>
    <a href={`/browse/${lang}/all/1`}>进入{lang}语法库</a>
  </body>
</html>
