---
import Base from '../layouts/Base.astro';
---
<Base title="搜索 · 拾页">
  <div class="glass mx-auto max-w-xl rounded-2xl p-10 text-center">
    <div class="text-4xl">🔎</div>
    <h1 class="mt-4 text-2xl font-bold text-slate-100">全文搜索</h1>
    <p class="mt-3 text-sm leading-relaxed text-slate-400">
      基于 Pagefind 的全文搜索即将上线，支持中/日/韩/泰/越混排查询。
    </p>
  </div>
</Base>
