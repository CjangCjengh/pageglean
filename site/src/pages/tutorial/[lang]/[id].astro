---
import Base from '../../../layouts/Base.astro';
import Flag from '../../../components/Flag.astro';
import { LANG_META, type Lang } from '../../../lib/langs';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const tuts = await getCollection('tutorials');
  return tuts.map((t) => {
    const [lang, id] = t.id.split('/');
    return { params: { lang, id }, props: { tut: t } };
  });
}

const { tut } = Astro.props;
const { Content } = await render(tut);
const lang = tut.data.id.split('-')[0] as Lang;
const meta = LANG_META[lang];
const grammarEntries = await getCollection('grammar', (e) => e.data.id === tut.data.id);
const grm = grammarEntries[0];
---
<Base title={`${tut.data.id} 教程 · 拾页`}>
  <div class="mx-auto max-w-3xl">
    <a href={grm ? `/grammar/${lang}/${tut.data.id}` : `/browse/${lang}`} class="flex items-center gap-1.5 text-sm text-faint hover:text-sub">
      ← <Flag lang={lang} class="h-3.5 w-5" /> 返回{grm ? '语法点' : '语法库'}
    </a>
    <p class="mt-3 rounded-lg border border-amber-500/30 bg-amber-500/10 px-4 py-2 text-xs text-amber-700 dark:text-amber-400/90">
      ⚠️ 本教程由 AI 自动生成，可能存在错误，仅供学习参考；重要用法请以权威词典与教材为准。
    </p>
    <div class="mt-6 tutorial-body">
      <Content />
    </div>
  </div>
</Base>

<style is:global>
  .tutorial-body h1 { font-size: 1.9rem; font-weight: 800; color: var(--fg-strong); margin-bottom: 1.5rem; }
  .tutorial-body h2 {
    font-size: 1.25rem; font-weight: 700; color: var(--fg-strong);
    margin-top: 2.5rem; margin-bottom: 0.9rem;
    border-left: 3px solid #38bdf8; padding-left: 0.7rem;
  }
  .tutorial-body p { color: var(--fg); line-height: 1.9; margin: 0.8rem 0; }
  .tutorial-body ul, .tutorial-body ol { color: var(--fg); padding-left: 1.4rem; margin: 0.8rem 0; list-style: disc; }
  .tutorial-body li { margin: 0.35rem 0; line-height: 1.8; }
  .tutorial-body strong { color: var(--fg-strong); }
  .tutorial-body code { background: var(--chip); padding: 0.1rem 0.4rem; border-radius: 0.3rem; font-size: 0.9em; }
</style>
