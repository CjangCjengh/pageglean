---
import { LANGS } from '../../lib/langs';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0; url=/vocab/${lang}/1`} />
    <title>跳转中……</title>
    <script is:inline define:vars={{ lang }}>
      location.replace(`/vocab/${lang}/1`);
    </script>
  </head>
  <body><a href={`/vocab/${lang}/1`}>进入{lang}词汇库</a></body>
</html>
